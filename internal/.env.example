# Copy to .env and fill in. Never commit the filled-in .env — this repo is public.

# Postgres connection string (pooled). Used by Prisma and scripts/deploy-db.mjs.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Direct (unpooled) Postgres connection. lib/db.ts prefers this over DATABASE_URL.
# Required for migrations; may be the same host without the pooler port.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# PIN that gates the THEIA facilitator console at /artifacts/theia/facilitator.
# Facilitator login is disabled entirely when this is unset.
FACILITATOR_PIN="choose-a-pin"

# HMAC key used to sign THEIA's facilitator cookie (lib/session.ts).
# Generate with: openssl rand -base64 32
# Falls back to FACILITATOR_PIN if unset, but set it explicitly in production.
SESSION_SECRET=""

# --- Platform identity (Google SSO) -----------------------------------------
# Auth.js signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth 2.0 client (Google Cloud Console -> APIs & Services -> Credentials
# -> OAuth client ID -> Web application). Authorized redirect URIs:
#   http://localhost:3010/api/auth/callback/google
#   https://internal.projectxvietnam.org/api/auth/callback/google
# Sign-in is open to any Google account by design — membership is decided by the
# admin approval queue at /admin/members, not by email domain.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails auto-approved as ADMIN on first sign-in. Without at least
# one, nobody can approve the first member — including you.
BOOTSTRAP_ADMIN_EMAILS=""
